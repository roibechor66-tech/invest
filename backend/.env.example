# Copy this file to ".env" in the same folder (backend/.env) and fill in
# real values. backend/app/core/config.py loads it automatically on
# startup (via python-dotenv) — no need to `set`/`export` these by hand in
# every new terminal. Never commit a real .env file (only this .example
# file should be tracked).

APP_SECRET_KEY=
DATABASE_URL=
# Only needed when deployed publicly (see README's "Deploying publicly"
# section) — comma-separated list of extra frontend origin(s) to allow,
# e.g. https://your-app.vercel.app . Local http://localhost:3000 is
# always allowed regardless of this.
CORS_ALLOWED_ORIGINS=
# Required for every real-AI bot feature. Paid (per-token usage, no free
# tier) — get a key and add billing credits at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# No longer used — reverted from the free Gemini API back to Anthropic
# above (Gemini's free tier quota was too small to be usable). Safe to
# leave blank/unset.
GEMINI_API_KEY=
GEMINI_MODEL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
FINNHUB_API_KEY=
# No longer used — fundamentals/portfolio-performance switched to
# yfinance (Yahoo Finance), which needs no key. Safe to leave blank/unset.
FMP_API_KEY=
